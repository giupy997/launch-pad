# /etc/notus/watch.env — the watch's settings, root-only (chmod 600): the bot's
# token is a secret (anyone holding it writes to your chat). Written on the VPS
# with `read -rs`, never pasted in a chat.
TG_BOT_TOKEN=
TG_CHAT_ID=
# Base nodes, comma-separated: a keyed one first (the one in contracts/.env),
# a public one after it; 9000 blocks a call on a keyed node, 1500 on a public one
NOTUS_WATCH_RPC=https://mainnet.base.org,https://base-rpc.publicnode.com
NOTUS_WATCH_CHUNK=1500
# optional: NOTUS_WATCH_HEARTBEAT_HOUR=8 (UTC), NOTUS_WATCH_SITE= (empty: the site is not watched),
# NOTUS_WATCH_TIMELOCKS / NOTUS_WATCH_PADS / NOTUS_WATCH_NAMES ("0xaddr=label,…")
