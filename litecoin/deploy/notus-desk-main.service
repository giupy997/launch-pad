# systemd unit for the Notus on Litecoin desk — MAINNET (runs next to the testnet one).
#
# The key, once:  NOTUS_LTC_NETWORK=main node litecoin/keygen.ts desk-main     # back it up, this one holds real LTC
# then move it out of the checkout, where `git pull` and `npm` cannot see it:
#   sudo mkdir -p /etc/notus && sudo mv litecoin/desk-main/key.json /etc/notus/desk-main.key
#   sudo chown root:root /etc/notus/desk-main.key && sudo chmod 0600 /etc/notus/desk-main.key
# systemd reads it as root and hands it to this service alone (LoadCredential).
#
#   sudo cp litecoin/deploy/notus-desk-main.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now notus-desk-main
#   journalctl -u notus-desk-main -f
[Unit]
Description=Notus on Litecoin desk (mainnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notus
WorkingDirectory=/home/notus/launch-pad
ExecStart=/usr/bin/node litecoin/desk.ts
Restart=always
RestartSec=10
# a stop waits for the pass in progress (a payout round is never cut in half)
TimeoutStopSec=180
KillSignal=SIGTERM
Environment=PORT=8788
Environment=NOTUS_LTC_NETWORK=main
Environment=NOTUS_LTC_DESK_DIR=/home/notus/launch-pad/litecoin/desk-main
Environment=NOTUS_LTC_STATE=/home/notus/launch-pad/litecoin/cache/main-state.json
Environment=NOTUS_LTC_CONFIRMATIONS=2
LoadCredential=desk-key:/etc/notus/desk-main.key
Environment=NOTUS_LTC_DESK_KEY_FILE=%d/desk-key
# litecoinspace.org's mainnet API answered 522 over IPv4 from this host while
# IPv6 worked: reach it over IPv6 first (IPv4 remains the fallback).
Environment=NODE_OPTIONS=--dns-result-order=ipv6first
# …and when it is down altogether, read the chain through a public Blockbook
# (Trezor's own blocks server IPs at Cloudflare; this one answered). With two
# sources a payout is only made when both confirm the sell behind it.
Environment=NOTUS_LTC_API=https://litecoinspace.org/api,https://litecoinblockexplorer.net/api/v2
# Environment=NOTUS_LTC_MAX_ROUND_LIT=500000000   # cap one payout round at 5 LTC

# the process may write its cache and its record of sent payouts, nothing else
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/notus/launch-pad/litecoin/cache /home/notus/launch-pad/litecoin/desk-main
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=1G

[Install]
WantedBy=multi-user.target
