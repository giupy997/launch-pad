# npm policy for the site (and for the points service and the watch, which run from its node_modules):
# no lifecycle script of any dependency runs on this machine (npm ci / npm install), only the scripts
# named on the command line (npm run build); every version saved is exact; the lock is the law.
# min-release-age is read by npm 11 and later: a version younger than seven days is not installed.
ignore-scripts=true
save-exact=true
package-lock=true
min-release-age=7
audit=true
fund=false
